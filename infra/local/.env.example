# Local development settings for infra/local/compose.yaml.
#
# Copy this file to infra/local/.env (git-ignored) and replace the password. These values are
# LOCAL-DEVELOPMENT PLACEHOLDERS ONLY: never reuse them, or any real credential, anywhere else.
# Docker Compose reads infra/local/.env automatically, also when run from the repository root with
# `-f infra/local/compose.yaml`. The same DB_* names configure the Go API and the migrate command when
# they run natively (see backend/README.md).

DB_NAME=sms
# The bootstrap superuser of the local PostgreSQL container. Only the postgres container and role
# provisioning use it; migrations run as sms_migrator and the API as sms_app (Phase 4 Group 1).
DB_USER=sms
# Required; there is no default. PostgreSQL uses it only when the database volume is first created:
# after changing it, reset the volume (infra/local/README.md, "Reset").
DB_PASSWORD=local-dev-only-change-me
# Required; no defaults. Passwords of the migration role (sms_migrator, used by the migrate service)
# and of the application role (sms_app, used by the API). Choose three different local-only values.
# Set on a fresh volume automatically; for an existing volume, or after changing them, run the
# provisioning command in infra/local/README.md ("Upgrading an existing database volume").
DB_MIGRATOR_PASSWORD=local-dev-only-change-me-migrator
DB_APP_PASSWORD=local-dev-only-change-me-app
# Host port for PostgreSQL, published on 127.0.0.1 only. Change it if 5432 is already in use.
DB_PORT=5432
# Host port for the API, published on 127.0.0.1 only. The client portal's development proxy expects
# 8080; change it only if 8080 is already in use (the proxy then cannot reach the API).
API_PORT=8080
