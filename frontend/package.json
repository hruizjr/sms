{
  "name": "@sms/frontend",
  "private": true,
  "description": "Frontend workspace: the client portal and the shared UI package (ADR-0013).",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "26.13.1",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "pnpm --filter @sms/client-portal dev",
    "build": "pnpm --filter @sms/client-portal build",
    "preview": "pnpm --filter @sms/client-portal preview",
    "test": "pnpm --recursive --sort test",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level moderate",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
