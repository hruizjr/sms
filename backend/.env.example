# Backend configuration (Phase 3 Groups 1-2; database roles from Phase 4 Group 1) for the api and
# migrate commands. Copy values into your shell or a local, git-ignored .env file. Every variable except DB_PASSWORD is optional; the
# values shown are the defaults.
# Never commit real secrets.

# development | test | production
APP_ENV=development

# Public application listener (host:port). Use :8080 to listen on all interfaces (e.g. in a container).
HTTP_ADDR=127.0.0.1:8080
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# How long graceful shutdown waits for in-flight requests before closing connections.
SHUTDOWN_TIMEOUT=15s

# Prometheus metrics listener. Must be a loopback IP (127.0.0.1 or [::1]); wildcard and
# non-loopback addresses are rejected. Non-loopback exposure is not supported in this phase.
METRICS_ADDR=127.0.0.1:9090

# text | json  (default: text when APP_ENV=development, json otherwise)
LOG_FORMAT=text
# debug | info | warn | error
LOG_LEVEL=info

# --- PostgreSQL (Phase 3 Group 2) -------------------------------------------------------------
# Shared by the api and migrate commands. For the local Docker Compose database, use the same
# values as infra/local/.env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sms
# The role to connect as (Phase 4 Group 1): sms_migrator for `migrate`, sms_app for `api`. Each process
# refuses an unsafe role (for example a superuser). The integration tests instead use the bootstrap
# superuser of the local PostgreSQL container (sms) together with the two role passwords below.
DB_USER=sms
# Required; no default. LOCAL-DEVELOPMENT PLACEHOLDER: replace it with your own local password (the
# password of the DB_USER role above).
DB_PASSWORD=local-dev-only-change-me
# Integration tests only: passwords of the roles sms_migrator and sms_app, as in infra/local/.env.
# The api and migrate commands do not read these; they read DB_USER and DB_PASSWORD.
DB_MIGRATOR_PASSWORD=local-dev-only-change-me-migrator
DB_APP_PASSWORD=local-dev-only-change-me-app
# disable | require | verify-ca | verify-full  (default: disable in development/test,
# verify-full in production; "disable" is rejected in production)
DB_SSLMODE=disable
# Pool size per process (1-100) and connections kept open when idle (0..DB_MAX_CONNS).
DB_MAX_CONNS=10
DB_MIN_CONNS=0
# Time allowed to establish one connection (TCP, TLS, authentication).
DB_CONNECT_TIMEOUT=5s
# Connections are recycled after this age / idle time.
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# --- Messaging (Phase 4 Group 2) ---------------------------------------------------------------
# The SMS provider adapter. Only the in-process simulator exists (no SMS is ever sent); it is
# refused in production, where no provider is configured yet.
SMS_PROVIDER=simulator
# Synthetic simulator settings (they describe no real network).
SIMULATOR_RECEIPT_DELAY=1s
# 0 = unknown segment limit (not enforced).
SIMULATOR_MAX_SEGMENTS=0
# 0 = disabled: submitted messages never become "unknown". There is no universal default.
SIMULATOR_REPORT_WINDOW=0
# Dispatcher (engineering defaults for local development, not telco terms).
DISPATCH_POLL_INTERVAL=500ms
DISPATCH_BATCH_SIZE=20
DISPATCH_CONCURRENCY=4
DISPATCH_SUBMIT_TIMEOUT=10s
# Must exceed DISPATCH_SUBMIT_TIMEOUT.
DISPATCH_LEASE=1m
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_RETRY_BASE_DELAY=2s
DISPATCH_RETRY_MAX_DELAY=5m
DISPATCH_MAX_MESSAGE_AGE=24h
