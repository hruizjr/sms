# Normalize line endings to LF for all text files.
* text=auto eol=lf

# Binary files — never apply line-ending conversion or text diffs.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.xlsx binary
*.woff binary
*.woff2 binary

# Generated files: collapsed in pull request diffs. Never edit them by hand; regenerate
# (backend/README.md, "OpenAPI code generation").
backend/internal/publicapi/*.gen.go linguist-generated=true
# sqlc output (backend/README.md, "sqlc").
backend/internal/database/sqlcgen/*.go linguist-generated=true
