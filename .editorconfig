# EditorConfig keeps basic formatting consistent across editors and AI agents.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go uses tabs (enforced by gofmt).
[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum}]
indent_style = tab

[Makefile]
indent_style = tab

# Markdown uses trailing double-spaces as hard line breaks.
[*.md]
trim_trailing_whitespace = false

[*.sql]
indent_size = 4
